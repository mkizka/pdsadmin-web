{
  "name": "pdsadmin-web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "node ./scripts/dev-env.ts vite --host",
    "e2e": "playwright test",
    "format": "eslint . --fix && prettier . --write",
    "lint": "eslint . && prettier . --check",
    "prepare": "husky",
    "preview": "node ./scripts/dev-env.ts vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@atcute/client": "5.1.2",
    "@conform-to/react": "1.21.3",
    "@conform-to/zod": "1.21.3",
    "@tailwindcss/vite": "4.3.4",
    "clsx": "2.1.1",
    "i18next": "26.7.1",
    "i18next-browser-languagedetector": "8.3.0",
    "jotai": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@atcute/atproto": "4.0.4",
    "@atproto/dev-env": "0.7.1",
    "@egoist/tailwindcss-icons": "1.9.2",
    "@iconify-json/lucide": "1.2.151",
    "@iconify-json/simple-icons": "1.2.101",
    "@mkizka/eslint-config": "10.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "daisyui": "5.7.50",
    "eslint": "10.14.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-pkg": "0.22.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-pkg",
      "prettier-plugin-tailwindcss"
    ]
  }
}
