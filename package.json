{
  "name": "pdsadmin-web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "run-s -sl setup-dev-env reset-dev-env && run-p -srl run-dev-env dev:vite",
    "dev:vite": "wait-on http://localhost:2583 && vite --host",
    "e2e": "playwright test",
    "format": "eslint . --fix && prettier . --write",
    "lint": "eslint . && prettier . --check",
    "prepare": "husky",
    "preview": "pnpm reset-dev-env && run-p -srl run-dev-env preview:vite",
    "preview:vite": "wait-on http://localhost:2583 && sleep 30 && vite preview",
    "reset-dev-env": "./scripts/reset-dev-env.sh",
    "run-dev-env": "./scripts/run-dev-env.sh",
    "setup-dev-env": "./scripts/setup-dev-env.sh",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@atcute/client": "5.1.1",
    "@conform-to/react": "1.21.1",
    "@conform-to/zod": "1.21.1",
    "@tailwindcss/vite": "4.3.3",
    "clsx": "2.1.1",
    "i18next": "26.4.1",
    "i18next-browser-languagedetector": "8.2.1",
    "jotai": "2.20.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@atcute/atproto": "4.0.4",
    "@egoist/tailwindcss-icons": "1.9.2",
    "@iconify-json/lucide": "1.2.128",
    "@iconify-json/simple-icons": "1.2.94",
    "@mkizka/eslint-config": "10.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react-swc": "4.3.3",
    "daisyui": "5.7.25",
    "eslint": "10.9.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "giget": "3.3.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-pkg": "0.22.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --fix",
    "*": "prettier --ignore-unknown --write"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-pkg",
      "prettier-plugin-tailwindcss"
    ]
  }
}
